{
  "name": "aptitude-beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "python3 tests/e2e.py",
    "check": "node scripts/check.mjs",
    "audit:bank": "python3 tools/audit_question_bank.py --check && python3 tools/audit_semantics.py",
    "build": "node scripts/build.mjs",
    "audit:curriculum": "node scripts/curriculum-report.mjs",
    "check:references": "python3 tools/check_references.py",
    "audit:college": "python3 tools/verify_college_math.py",
    "test:math": "python3 -m unittest discover -s tests -p 'test_college_math.py' -v",
    "dev:beta": "node server/main.js",
    "test:launch:e2e": "python3 tests/launch_e2e.py",
    "owner": "node server/owner.js"
  },
  "devDependencies": {
    "axe-core": "4.11.0"
  }
}
